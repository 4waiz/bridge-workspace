{
  "version": 2,
  "installCommand": "HUSKY=0 corepack yarn install --mode=skip-build",
  "buildCommand": "HUSKY=0 corepack yarn workspace @affine/templates build && HUSKY=0 corepack yarn affine web build",
  "outputDirectory": "packages/frontend/apps/web/dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
