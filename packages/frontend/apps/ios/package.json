{
  "name": "@bridgeflow/ios",
  "version": "0.26.3",
  "description": "BridgeFlow Desktop Web application",
  "type": "module",
  "private": true,
  "browser": "src/index.tsx",
  "scripts": {
    "build": "bridgeflow bundle",
    "dev": "bridgeflow bundle --dev",
