    "@bridgeflow/i18n": "workspace:*",
    "@bridgeflow/mobile-shared": "workspace:*",
    "@bridgeflow/nbstore": "workspace:*",
    "@bridgeflow/track": "workspace:*",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@kanban-studios/infra": "workspace:^",
    "@sentry/react": "^10.40.0",
