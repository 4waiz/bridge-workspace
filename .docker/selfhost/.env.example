# select a revision to deploy, available values: stable, beta, canary
BRIDGEFLOW_REVISION=stable

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links
# BRIDGEFLOW_SERVER_HTTPS=true
# BRIDGEFLOW_SERVER_HOST=bridgeflow.yourdomain.com
# or 
# BRIDGEFLOW_SERVER_EXTERNAL_URL=https://bridgeflow.yourdomain.com

# position of the database data to persist
DB_DATA_LOCATION=~/.bridgeflow/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=~/.bridgeflow/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=~/.bridgeflow/self-host/config

# database credentials
DB_USERNAME=bridgeflow
DB_PASSWORD=
DB_DATABASE=bridgeflow
