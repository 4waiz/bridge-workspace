{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch BridgeFlow Cloud",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "bridgeflow",
        "@bridgeflow/server",
        "dev"
      ]
    },
    {
      "name": "Lanuch BridgeFlow Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "bridgeflow",
        "@bridgeflow/web",
        "dev"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug BridgeFlow Web",
      "url": "http://localhost:8080"
    }
  ]
}